{
  "name": "@veille/mcp",
  "version": "0.1.0",
  "description": "Veille MCP server: Validate emails, domains, IPs, VAT numbers and IBANs in milliseconds to block fake sign-ups, bots and fraud.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "veille-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "llms-install.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "format:check": "prettier --check .",
    "mcpb:pack": "npm run build && node scripts/prepare-mcpb.mjs && mcpb pack mcpb",
    "prepack": "npm run build",
    "start": "node dist/stdio.js",
    "start:http": "node dist/stdio.js --http",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "Veille",
  "license": "MIT",
  "mcpName": "io.veille/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veilleio/veille-mcp.git"
  },
  "homepage": "https://github.com/veilleio/veille-mcp#readme",
  "bugs": {
    "url": "https://github.com/veilleio/veille-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-tools",
    "veille",
    "email-validation",
    "fraud-prevention",
    "vat-validation",
    "ip-reputation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@veille/sdk": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
